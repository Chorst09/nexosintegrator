// === PRÉ-VENDAS ===
model PreSalesRequest {
  id                  String   @id @default(uuid())
  numero              String   @unique
  titulo              String
  descricao           String
  nomeCliente         String?  // Nome do cliente
  modalidade          String?  // 'VENDA', 'LOCACAO', 'SERVICO'
  status              PreSalesStatus @default(NOVA)
  prioridade          Priority @default(MEDIUM)
  tiposPrecificacao   String[] // ['VENDA', 'LOCACAO', 'SERVICOS']
  regimeTributario    String?  // 'LUCRO_PRESUMIDO', 'LUCRO_REAL', 'SIMPLES_NACIONAL'
  valorSugerido       Float?
  custoTotal          Float?
  margemLucro         Float?
  calculoDetalhes     Json?    // Detalhes do cálculo de precificação
  observacoes         String?
  dataAprovacao       DateTime?
  dataRejeicao        DateTime?
  
  // Relacionamentos
  solicitanteId       String
  solicitante         User     @relation("PreSalesRequester", fields: [solicitanteId], references: [id])
  leadId              String?
  lead                Company? @relation("PreSalesLead", fields: [leadId], references: [id])
  opportunityId       String?
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id])
  aprovadoPorId       String?
  aprovadoPor         User?    @relation("PreSalesApprover", fields: [aprovadoPorId], references: [id])
  rejeitadoPorId      String?
  rejeitadoPor        User?    @relation("PreSalesRejecter", fields: [rejeitadoPorId], references: [id])
  
  items               PreSalesItem[]
  aprovacoes          PreSalesApproval[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PreSalesItem {
  id                  String   @id @default(uuid())
  preSalesRequestId   String
  preSalesRequest     PreSalesRequest @relation(fields: [preSalesRequestId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation("PreSalesProduct", fields: [productId], references: [id])
  descricao           String?  // Para itens customizados sem produto
  quantidade          Int      @default(1)
  custoUnitario       Float    @default(0)
  precoSugerido       Float    @default(0)
  margemLucro         Float    @default(0)
  observacoes         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PreSalesApproval {
  id                  String   @id @default(uuid())
  preSalesRequestId   String
  preSalesRequest     PreSalesRequest @relation(fields: [preSalesRequestId], references: [id], onDelete: Cascade)
  aprovadorId         String
  aprovador           User     @relation("PreSalesApprovalApprover", fields: [aprovadorId], references: [id])
  status              ApprovalStatus
  observacoes         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PreSalesPoc {
  id                       String   @id @default(uuid())
  relatedOpportunityId     String?
  relatedOpportunityNumber String?
  relatedOpportunityTitle  String?
  title                    String
  client                   String
  solution                 String
  environment              String?
  objective                String
  scope                    String?
  successCriteria          String
  commercialOwner          String
  technicalOwner           String
  startDate                DateTime?
  dueDate                  DateTime?
  priority                 Priority @default(MEDIUM)
  status                   String   @default("PLANEJAMENTO")
  progress                 Int      @default(0)
  nextStep                 String?
  risks                    String?
  resultSummary            String?
  decisionReason           String?
  notes                    String?
  createdById              String?
  createdByName            String?
  approvedAt               DateTime?
  discardedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  followUps                PreSalesPocFollowUp[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([relatedOpportunityId])
}

model PreSalesPocFollowUp {
  id            String      @id @default(uuid())
  pocId         String
  poc           PreSalesPoc @relation(fields: [pocId], references: [id], onDelete: Cascade)
  note          String
  nextStep      String?
  status        String?
  progress      Int?
  createdById   String?
  createdByName String?
  createdAt     DateTime    @default(now())

  @@index([pocId, createdAt])
}

