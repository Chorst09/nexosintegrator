generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === CADASTRO MESTRE ===
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SELLER)
  tenantCompanyId String?
  tenantCompany TenantCompany? @relation(fields: [tenantCompanyId], references: [id], onDelete: SetNull)
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id])
  quota     Float?
  commissionSalePercentage Float?
  commissionProject12 Float?
  commissionProject24 Float?
  commissionProject36 Float?
  commissionProject48 Float?
  commissionProject60 Float?
  accessB2B Boolean  @default(true)
  accessB2G Boolean  @default(true)
  accessPreSales Boolean @default(false)
  accessManagement Boolean @default(false)
  accessAutomation Boolean @default(false)
  permissionOverrides Json @default("{}")
  isCompanyOwner Boolean @default(false)
  createdAt DateTime @default(now())
  
  // Relacionamentos
  opportunities       Opportunity[]
  activities          Activity[]
  commissions         Commission[]
  approvalRequests    ApprovalRequest[] @relation("ApprovalRequester")
  approvalSteps       ApprovalStep[]    @relation("ApprovalApprover")
  salesTargets        SalesTarget[]
  teamBonusDistributions TeamBonusDistribution[]
  workflowExecutions  WorkflowExecution[]
  notifications       Notification[]
  customerOnboardings CustomerOnboarding[]
  supportTickets      SupportTicket[]
  ticketResponses     TicketResponse[]
  churnAlerts         ChurnAlert[]
  preSalesRequests    PreSalesRequest[] @relation("PreSalesRequester")
  preSalesApproved    PreSalesRequest[] @relation("PreSalesApprover")
  preSalesRejected    PreSalesRequest[] @relation("PreSalesRejecter")
  preSalesApprovals   PreSalesApproval[] @relation("PreSalesApprovalApprover")
  opportunityFollowUps OpportunityFollowUp[] @relation("OpportunityFollowUps")
  managedProjects    Project[] @relation("ProjectManager")
  createdProjects    Project[] @relation("ProjectCreator")
  projectTasks       ProjectTask[]
  projectTeams       ProjectTeam[]
  projectTimelogs    ProjectTimelog[]
  projectRisks       ProjectRisk[]
  issueReported      ProjectIssue[] @relation("IssueReporter")
  issueAssigned      ProjectIssue[] @relation("IssueAssignee")
  crRequested        ProjectChangeRequest[] @relation("CRRequester")
  crApproved         ProjectChangeRequest[] @relation("CRApprover")
  acceptancesApproved ProjectAcceptance[] @relation("AcceptanceApprover")

  @@index([tenantCompanyId])
  @@index([role])
}

model Company {
  id          String   @id @default(uuid())
  name        String
  document    String?
  segment     String?
  clientType  ClientType @default(B2B)
  size        CompanySize?
  website     String?
  logo        String?
  address     String?
  city        String?
  state       String?
  country     String   @default("Brasil")
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  status      CompanyStatus @default(ACTIVE)
  leadScore   Int      @default(0)
  churnRisk   Float    @default(0)
  accessB2B   Boolean  @default(true)
  accessB2G   Boolean  @default(false)
  accessPreSales Boolean @default(false)
  accessManagement Boolean @default(false)
  accessAutomation Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relacionamentos
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  contracts     Contract[]
  documents     CompanyDocument[]
  customerOnboardings CustomerOnboarding[]
  supportTickets SupportTicket[]
  npssurveys    NPSSurvey[]
  churnAlerts   ChurnAlert[]
  preSalesLeads PreSalesRequest[] @relation("PreSalesLead")
  integrationOrders IntegrationOrder[]
  projects          Project[]
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean  @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  price       Float
  margin      Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  // Relacionamentos
  opportunities OpportunityProduct[]
  proposals     ProposalItem[]
  prices        ProductPrice[]
  crossSells    CrossSellRule[] @relation("MainProduct")
  upSells       UpSellRule[]    @relation("MainProduct")
  suggestedBy   CrossSellRule[] @relation("SuggestedProduct")
  upSellTarget  UpSellRule[]    @relation("TargetProduct")
  preSalesItems PreSalesItem[]  @relation("PreSalesProduct")
}

// === FUNIL DE VENDAS ===
model Opportunity {
  id              String   @id @default(uuid())
  number          String?  @unique
  title           String
  projectName     String?
  projectClientType String?
  projectType     String   @default("SINGLE")
  projectMonths   Int?
  description     String?
  value           Float
  probability     Int      @default(50)
  stage           Stage
  b2gStage        String?
  source          LeadSource?
  expectedCloseDate DateTime?
  actualCloseDate DateTime?
  lossReason      String?
  notes           String?
  
  // Relacionamentos
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id])
  
  products    OpportunityProduct[]
  activities  Activity[]
  proposals   Proposal[]
  commission  Commission?
  competitors CompetitorComparison[]
  preSalesRequests PreSalesRequest[]
  integrationOrders IntegrationOrder[]
  followUps   OpportunityFollowUp[]
  project     Project?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([b2gStage])
}

model OpportunityFollowUp {
  id            String   @id @default(uuid())
  type          String   // CALL, EMAIL, MEETING, NOTE, WHATSAPP, etc
  content       String
  attachments   String?  // JSON com URLs de anexos
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("OpportunityFollowUps", fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@index([opportunityId])
  @@index([userId])
  @@index([createdAt])
}

model OpportunityProduct {
  id            String      @id @default(uuid())
  quantity      Int         @default(1)
  unitPrice     Float
  discount      Float       @default(0)
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  
  @@unique([opportunityId, productId])
}

// === GESTÃO DE ATIVIDADES ===
model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  subject     String
  description String?
  status      ActivityStatus @default(PENDING)
  priority    Priority     @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  
  // Relacionamentos
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId  String
  assignedTo    User @relation(fields: [assignedToId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === PROPOSTAS ===
model Proposal {
  id          String   @id @default(uuid())
  number      String   @unique
  type        ProposalType @default(COMMERCIAL)
  title       String
  description String?
  sectionsData Json    @default("{}") // Conteudo das secoes do template (texto/campos por secao)
  totalValue  Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  status      ProposalStatus @default(DRAFT)
  validUntil  DateTime?
  version     Int      @default(1)
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  priceTableId  String?
  priceTable    PriceTable? @relation(fields: [priceTableId], references: [id])
  templateId    String?
  template      ProposalTemplate? @relation(fields: [templateId], references: [id])
  
  items     ProposalItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalTemplate {
  id          String   @id @default(uuid())
  name        String
  type        ProposalType @default(COMMERCIAL)
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  
  // Configurações da Capa
  coverEnabled     Boolean @default(true)
  coverTitle       String?
  coverSubtitle    String?
  coverLogo        String?
  coverBackground  String?
  
  // Configurações do Cabeçalho
  headerEnabled    Boolean @default(true)
  headerLogo       String?
  headerText       String?
  headerHeight     Int     @default(80)
  
  // Configurações do Rodapé
  footerEnabled    Boolean @default(true)
  footerText       String?
  footerLogo       String?
  footerHeight     Int     @default(60)
  
  // Configurações do Índice
  indexEnabled     Boolean @default(true)
  indexTitle       String  @default("Índice")
  
  // Configurações de Seções
  sections         Json    // Array de seções configuráveis
  
  // Configurações de Estilo
  primaryColor     String  @default("#3B82F6")
  secondaryColor   String  @default("#64748B")
  fontFamily       String  @default("Inter")
  fontSize         Int     @default(12)
  
  // Configurações de Layout
  pageMargins      Json    @default("{\"top\": 40, \"right\": 40, \"bottom\": 40, \"left\": 40}")
  pageSize         String  @default("A4")
  pageOrientation  String  @default("portrait")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  proposals Proposal[]
}

model ProposalItem {
  id          String   @id @default(uuid())
  quantity    Int      @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  totalPrice  Float
  
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
}

// === COMISSIONAMENTO ===
model Commission {
  id            String   @id @default(uuid())
  percentage    Float
  amount        Float
  calculationBase Float?
  projectType   String   @default("SINGLE")
  projectMonths Int?
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  
  opportunityId String   @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === INTEGRAÇÕES ===
model Integration {
  id          String   @id @default(uuid())
  name        String
  type        IntegrationType
  provider    IntegrationProvider @default(CUSTOM)
  partnerTier PartnerTier @default(BRONZE)
  config      Json
  isActive    Boolean  @default(true)
  apiKey      String?
  clientId    String?  @unique
  clientSecretHash String?
  scopes      String[] @default([])
  rateLimitPerMinute Int?
  webhookSigningSecret String?
  metadata    Json?
  webhookUrl  String?
  lastSync    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  syncLogs          IntegrationLog[]
  oauthTokens       IntegrationAccessToken[]
  rateLimitWindows  IntegrationRateLimitWindow[]
  idempotencyKeys   IntegrationIdempotencyKey[]
  webhookEndpoints  IntegrationWebhookEndpoint[]
  webhookDeliveries IntegrationWebhookDelivery[]
  fieldMappings     IntegrationFieldMapping[]
  customFields      IntegrationCustomField[]
  entityMappings    IntegrationEntityMapping[]
  entityData        IntegrationEntityData[]
  orders            IntegrationOrder[]
}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  action        String
  status        LogStatus
  message       String?
  data          Json?
  createdAt     DateTime @default(now())
}

model IntegrationAccessToken {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  scopes        String[]    @default([])
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([integrationId, expiresAt])
  @@index([tokenHash, expiresAt])
}

model IntegrationRateLimitWindow {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  windowStart   DateTime
  requestCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, windowStart])
  @@index([windowStart])
}

model IntegrationIdempotencyKey {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  scope         String
  key           String
  requestHash   String
  statusCode    Int
  responseBody  Json?
  createdAt     DateTime    @default(now())
  expiresAt     DateTime

  @@unique([integrationId, scope, key])
  @@index([expiresAt])
}

model IntegrationWebhookEndpoint {
  id              String                     @id @default(uuid())
  integrationId   String
  integration     Integration                @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType       String
  url             String
  secret          String?
  isActive        Boolean                    @default(true)
  maxRetries      Int                        @default(5)
  timeoutMs       Int                        @default(10000)
  lastTriggeredAt DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  deliveries      IntegrationWebhookDelivery[]

  @@index([integrationId, eventType, isActive])
}

model IntegrationWebhookDelivery {
  id              String                     @id @default(uuid())
  endpointId      String
  endpoint        IntegrationWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  integrationId   String
  integration     Integration                @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json
  idempotencyKey  String?
  status          WebhookDeliveryStatus      @default(PENDING)
  attempt         Int                        @default(0)
  maxRetries      Int                        @default(5)
  httpStatus      Int?
  errorResponse   String?
  nextAttemptAt   DateTime?
  sentAt          DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([integrationId, eventType, createdAt])
}

model IntegrationFieldMapping {
  id            String            @id @default(uuid())
  integrationId String
  integration   Integration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  module        IntegrationModule
  entityType    IntegrationEntityType
  sourceField   String
  targetField   String
  transformRule Json?
  defaultValue  String?
  isCustom      Boolean           @default(false)
  isRequired    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([integrationId, module, entityType, sourceField])
  @@index([integrationId, module, entityType])
}

model IntegrationCustomField {
  id            String              @id @default(uuid())
  integrationId String
  integration   Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  module        IntegrationModule
  entityType    IntegrationEntityType
  fieldKey      String
  label         String
  dataType      CustomFieldDataType @default(STRING)
  description   String?
  totvsFieldCode String?
  isRequired    Boolean             @default(false)
  defaultValue  Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([integrationId, module, entityType, fieldKey])
  @@index([integrationId, module, entityType])
}

model IntegrationEntityMapping {
  id            String              @id @default(uuid())
  integrationId String
  integration   Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  module        IntegrationModule
  entityType    IntegrationEntityType
  internalId    String
  externalId    String
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([integrationId, module, entityType, externalId])
  @@index([integrationId, module, entityType, internalId])
}

model IntegrationEntityData {
  id            String              @id @default(uuid())
  integrationId String
  integration   Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  module        IntegrationModule
  entityType    IntegrationEntityType
  entityId      String
  data          Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([integrationId, module, entityType, entityId])
  @@index([integrationId, module, entityType])
}

model IntegrationOrder {
  id              String      @id @default(uuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalOrderId String
  companyId       String?
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  status          String      @default("PENDING")
  currency        String      @default("BRL")
  totalValue      Float
  issuedAt        DateTime?
  payload         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([integrationId, externalOrderId])
  @@index([companyId, issuedAt])
}

// === LICENCIAMENTO MULTIEMPRESA ===
model TenantCompany {
  id          String              @id @default(uuid())
  name        String
  legalName   String?
  cnpj        String?             @unique
  email       String?
  phone       String?
  status      TenantCompanyStatus @default(PROSPECT)
  notes       String?
  accessB2B   Boolean             @default(true)
  accessB2G   Boolean             @default(false)
  accessPreSales Boolean          @default(false)
  accessManagement Boolean        @default(false)
  accessAutomation Boolean        @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  users       User[]
  licenses    CompanyLicense[]

  @@index([status, createdAt])
}

model LicensePlan {
  id            String              @id @default(uuid())
  code          String              @unique
  name          String
  description   String?
  billingCycle  LicenseBillingCycle
  price         Float
  currency      String              @default("BRL")
  seatsIncluded Int                 @default(1)
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  features      Json                @default("{}")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  licenses      CompanyLicense[]

  @@index([isActive, sortOrder])
}

model CompanyLicense {
  id                  String          @id @default(uuid())
  tenantCompanyId     String
  tenantCompany       TenantCompany   @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  planId              String
  plan                LicensePlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  status              LicenseStatus   @default(PENDING)
  seats               Int             @default(1)
  startDate           DateTime
  endDate             DateTime
  priceAtPurchase     Float
  notes               String?
  paymentReference    String?         @unique
  paymentStatus       PaymentStatus   @default(PENDING)
  paymentConfirmedAt  DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([tenantCompanyId, status, endDate])
  @@index([paymentStatus, createdAt])
}

// === FUNCIONALIDADES AVANÇADAS ===
model PriceTable {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  validFrom   DateTime
  validUntil  DateTime?
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  customerSegment String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  prices      ProductPrice[]
  proposals   Proposal[]
}

model ProductPrice {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  priceTableId String
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id])
  price        Float
  minQuantity  Int        @default(1)
  maxQuantity  Int?
  discount     Float      @default(0)
  
  @@unique([productId, priceTableId, minQuantity])
}

model Competitor {
  id          String   @id @default(uuid())
  name        String
  website     String?
  strengths   String?
  weaknesses  String?
  pricing     String?
  marketShare Float?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  comparisons CompetitorComparison[]
}

model CompetitorComparison {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  competitorId  String
  competitor    Competitor  @relation(fields: [competitorId], references: [id])
  status        CompetitorStatus
  notes         String?
  createdAt     DateTime    @default(now())
}

model Region {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  country     String   @default("Brasil")
  state       String?
  city        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  users       User[]
  companies   Company[]
  priceTables PriceTable[]
  teamBonuses TeamBonus[]
}

model ApprovalWorkflow {
  id          String   @id @default(uuid())
  name        String
  type        WorkflowType
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  approvals   ApprovalRequest[]
}

model ApprovalRequest {
  id          String            @id @default(uuid())
  workflowId  String
  workflow    ApprovalWorkflow  @relation(fields: [workflowId], references: [id])
  entityType  String
  entityId    String
  requesterId String
  requester   User              @relation("ApprovalRequester", fields: [requesterId], references: [id])
  currentStep Int               @default(0)
  status      ApprovalStatus
  data        Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  steps       ApprovalStep[]
}

model ApprovalStep {
  id          String          @id @default(uuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id])
  stepNumber  Int
  approverId  String
  approver    User            @relation("ApprovalApprover", fields: [approverId], references: [id])
  status      StepStatus
  comments    String?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
}

// === CROSS-SELL E UPSELL ===
model CrossSellRule {
  id                String  @id @default(uuid())
  name              String
  mainProductId     String
  mainProduct       Product @relation("MainProduct", fields: [mainProductId], references: [id])
  suggestedProductId String
  suggestedProduct  Product @relation("SuggestedProduct", fields: [suggestedProductId], references: [id])
  probability       Float   @default(0.5)
  discount          Float   @default(0)
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
}

model UpSellRule {
  id              String  @id @default(uuid())
  name            String
  mainProductId   String
  mainProduct     Product @relation("MainProduct", fields: [mainProductId], references: [id])
  targetProductId String
  targetProduct   Product @relation("TargetProduct", fields: [targetProductId], references: [id])
  minQuantity     Int     @default(1)
  discount        Float   @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
}

// === METAS DE VENDAS ===
model SalesTarget {
  id              String   @id @default(uuid())
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])
  targetValue     Float
  targetDeals     Int      @default(0)
  startDate       DateTime
  endDate         DateTime
  description     String?
  bonusPercentage Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// === COMISSÕES POR EQUIPE ===
model TeamBonus {
  id            String   @id @default(uuid())
  regionId      String?
  region        Region?  @relation(fields: [regionId], references: [id])
  totalAmount   Float
  description   String
  period        String
  criteria      Json
  createdAt     DateTime @default(now())
  
  distributions TeamBonusDistribution[]
}

model TeamBonusDistribution {
  id           String    @id @default(uuid())
  teamBonusId  String
  teamBonus    TeamBonus @relation(fields: [teamBonusId], references: [id])
  sellerId     String
  seller       User      @relation(fields: [sellerId], references: [id])
  amount       Float
  percentage   Float
  createdAt    DateTime  @default(now())
}

// === WORKFLOWS AVANÇADOS ===
model AdvancedWorkflow {
  id              String   @id @default(uuid())
  name            String
  description     String?
  type            WorkflowAdvancedType
  category        WorkflowCategory @default(GENERAL)
  trigger         Json
  conditions      Json
  actions         Json
  escalationRules Json?
