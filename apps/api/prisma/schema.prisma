model PendingSubscription {
  id                String   @id @default(uuid())
  planId            String
  planName          String
  price             Float
  companyName       String
  document          String
  email             String
  phone             String
  responsibleName   String
  responsibleEmail  String
  responsiblePhone  String
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  paymentData       Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([responsibleEmail])
}

// === MÓDULO DE PROJETOS ===
model Project {
  id              String   @id @default(uuid())
  number          String   @unique
  name            String
  description     String?
  type            ProjectType
  phase           ProjectPhaseType @default(SETUP)
  status          ProjectStatus @default(PLANEJADO)
  budget          Float    @default(0)
  actualCost      Float    @default(0)
  margin          Float    @default(0)
  plannedStartDate DateTime?
  plannedEndDate  DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  healthScore     Int      @default(100)
  progressPercent Int      @default(0)
  metadata        Json     @default("{}")

  opportunityId   String?  @unique
  contractId      String?
  companyId       String
  projectManagerId String
  createdBy       String

  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contract        Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  company         Company      @relation(fields: [companyId], references: [id])
  projectManager  User         @relation("ProjectManager", fields: [projectManagerId], references: [id])
  creator         User         @relation("ProjectCreator", fields: [createdBy], references: [id])

  phases          ProjectPhase[]
  milestones      ProjectMilestone[]
  tasks           ProjectTask[]
  team            ProjectTeam[]
  timelogs        ProjectTimelog[]
  risks           ProjectRisk[]
  issues          ProjectIssue[]
  attachments     ProjectAttachment[]
  changeRequests  ProjectChangeRequest[]
  billings        ProjectBilling[]
  acceptances     ProjectAcceptance[]
  b2gConfig       ProjectB2GConfig?
  b2bConfig       ProjectB2BConfig?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([projectManagerId])
  @@index([status])
  @@index([phase])
  @@index([type])
}

model ProjectPhase {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  order           Int
  status          ProjectPhaseStatus @default(PENDING)
  plannedStartDate DateTime?
  plannedEndDate  DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  progressPercent Int      @default(0)

  milestones      ProjectMilestone[]
  tasks           ProjectTask[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([order])
}

model ProjectMilestone {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId         String?
  phase           ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  status          MilestoneStatus @default(PENDING)
  plannedDate     DateTime?
  actualDate      DateTime?
  billingTrigger  Boolean  @default(false)
  billingValue    Float    @default(0)
  deliverables    Json     @default("[]")

  tasks           ProjectTask[]
  billings        ProjectBilling[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([status])
}

model ProjectTask {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId         String?
  phase           ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id])
  estimatedHours  Float    @default(0)
  actualHours     Float    @default(0)
  dependencyId    String?
  dependency      ProjectTask? @relation("TaskDependency", fields: [dependencyId], references: [id])
  dependents      ProjectTask[] @relation("TaskDependency")

  timelogs        ProjectTimelog[]
  issues          ProjectIssue[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([milestoneId])
  @@index([assignedToId])
  @@index([status])
}

model ProjectTeam {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  role            ProjectRole @default(DEVELOPER)
  allocationPercent Float  @default(100)
  hourlyCost      Float    @default(0)
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean  @default(true)

  timelogs        ProjectTimelog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectTimelog {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String
  task            ProjectTask @relation(fields: [taskId], references: [id])
  teamId          String?
  team            ProjectTeam? @relation(fields: [teamId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  logDate         DateTime
  hours           Float
  description     String?
  billable        Boolean  @default(true)

  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([logDate])
}

model ProjectRisk {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  level           RiskLevel @default(MEDIUM)
  status          RiskStatus @default(IDENTIFIED)
  impact          String?
  mitigationPlan  String?
  ownerId         String?
  owner           User?    @relation(fields: [ownerId], references: [id])
  identifiedDate  DateTime @default(now())
  resolvedDate    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([level])
  @@index([status])
}

model ProjectIssue {
