generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === CADASTRO MESTRE ===
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SELLER)
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id])
  quota     Float?
  commissionSalePercentage Float?
  commissionProject12 Float?
  commissionProject24 Float?
  commissionProject36 Float?
  commissionProject48 Float?
  commissionProject60 Float?
  createdAt DateTime @default(now())
  
  // Relacionamentos
  opportunities       Opportunity[]
  activities          Activity[]
  commissions         Commission[]
  approvalRequests    ApprovalRequest[] @relation("ApprovalRequester")
  approvalSteps       ApprovalStep[]    @relation("ApprovalApprover")
  salesTargets        SalesTarget[]
  teamBonusDistributions TeamBonusDistribution[]
  workflowExecutions  WorkflowExecution[]
  notifications       Notification[]
  preSalesRequests    PreSalesRequest[]   @relation("PreSalesRequester")
  preSalesApprovals   PreSalesRequest[]   @relation("PreSalesApprover")
  preSalesRejections  PreSalesRequest[]   @relation("PreSalesRejecter")
  preSalesApprovalActions PreSalesApproval[] @relation("PreSalesApprovalApprover")
  customerOnboardings CustomerOnboarding[]
  supportTickets      SupportTicket[]
  ticketResponses     TicketResponse[]
  churnAlerts         ChurnAlert[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  document    String?
  segment     String?
  size        CompanySize?
  website     String?
  logo        String?
  address     String?
  city        String?
  state       String?
  country     String   @default("Brasil")
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  status      CompanyStatus @default(ACTIVE)
  leadScore   Int      @default(0)
  churnRisk   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relacionamentos
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  contracts     Contract[]
  documents     CompanyDocument[]
  customerOnboardings CustomerOnboarding[]
  supportTickets SupportTicket[]
  npssurveys    NPSSurvey[]
  churnAlerts   ChurnAlert[]
  preSalesLeads PreSalesRequest[] @relation("PreSalesLead")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean  @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  price       Float
  margin      Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  // Relacionamentos
  opportunities OpportunityProduct[]
  proposals     ProposalItem[]
  prices        ProductPrice[]
  crossSells    CrossSellRule[] @relation("MainProduct")
  upSells       UpSellRule[]    @relation("MainProduct")
  suggestedBy   CrossSellRule[] @relation("SuggestedProduct")
  upSellTarget  UpSellRule[]    @relation("TargetProduct")
  preSalesItems PreSalesItem[] @relation("PreSalesProduct")
}

// === FUNIL DE VENDAS ===
model Opportunity {
  id              String   @id @default(uuid())
  title           String
  projectType     String   @default("SINGLE")
  projectMonths   Int?
  description     String?
  value           Float
  probability     Int      @default(50)
  stage           Stage
  source          LeadSource?
  expectedCloseDate DateTime?
  actualCloseDate DateTime?
  lossReason      String?
  notes           String?
  
  // Relacionamentos
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id])
  
  products    OpportunityProduct[]
  activities  Activity[]
  proposals   Proposal[]
  commission  Commission?
  competitors CompetitorComparison[]
  preSalesRequests PreSalesRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpportunityProduct {
  id            String      @id @default(uuid())
  quantity      Int         @default(1)
  unitPrice     Float
  discount      Float       @default(0)
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  
  @@unique([opportunityId, productId])
}

// === GESTÃO DE ATIVIDADES ===
model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  subject     String
  description String?
  status      ActivityStatus @default(PENDING)
  priority    Priority     @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  
  // Relacionamentos
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId  String
  assignedTo    User @relation(fields: [assignedToId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === PROPOSTAS ===
model Proposal {
  id          String   @id @default(uuid())
  number      String   @unique
  title       String
  description String?
  totalValue  Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  status      ProposalStatus @default(DRAFT)
  validUntil  DateTime?
  version     Int      @default(1)
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  priceTableId  String?
  priceTable    PriceTable? @relation(fields: [priceTableId], references: [id])
  templateId    String?
  template      ProposalTemplate? @relation(fields: [templateId], references: [id])
  
  items     ProposalItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  
  // Configurações da Capa
  coverEnabled     Boolean @default(true)
  coverTitle       String?
  coverSubtitle    String?
  coverLogo        String?
  coverBackground  String?
  
  // Configurações do Cabeçalho
  headerEnabled    Boolean @default(true)
  headerLogo       String?
  headerText       String?
  headerHeight     Int     @default(80)
  
  // Configurações do Rodapé
  footerEnabled    Boolean @default(true)
  footerText       String?
  footerLogo       String?
  footerHeight     Int     @default(60)
  
  // Configurações do Índice
  indexEnabled     Boolean @default(true)
  indexTitle       String  @default("Índice")
  
  // Configurações de Seções
  sections         Json    // Array de seções configuráveis
  
  // Configurações de Estilo
  primaryColor     String  @default("#3B82F6")
  secondaryColor   String  @default("#64748B")
  fontFamily       String  @default("Inter")
  fontSize         Int     @default(12)
  
  // Configurações de Layout
  pageMargins      Json    @default("{\"top\": 40, \"right\": 40, \"bottom\": 40, \"left\": 40}")
  pageSize         String  @default("A4")
  pageOrientation  String  @default("portrait")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  proposals Proposal[]
}

model ProposalItem {
  id          String   @id @default(uuid())
  quantity    Int      @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  totalPrice  Float
  
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
}

// === COMISSIONAMENTO ===
model Commission {
  id            String   @id @default(uuid())
  percentage    Float
  amount        Float
  calculationBase Float?
  projectType   String   @default("SINGLE")
  projectMonths Int?
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  
  opportunityId String   @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === INTEGRAÇÕES ===
model Integration {
  id          String   @id @default(uuid())
  name        String
  type        IntegrationType
  config      Json
  isActive    Boolean  @default(true)
  apiKey      String?
  webhookUrl  String?
  lastSync    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  syncLogs    IntegrationLog[]
}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  action        String
  status        LogStatus
  message       String?
  data          Json?
  createdAt     DateTime @default(now())
}

// === FUNCIONALIDADES AVANÇADAS ===
model PriceTable {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  validFrom   DateTime
  validUntil  DateTime?
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  customerSegment String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  prices      ProductPrice[]
  proposals   Proposal[]
}

model ProductPrice {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  priceTableId String
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id])
  price        Float
  minQuantity  Int        @default(1)
  maxQuantity  Int?
  discount     Float      @default(0)
  
  @@unique([productId, priceTableId, minQuantity])
}

model Competitor {
  id          String   @id @default(uuid())
  name        String
  website     String?
  strengths   String?
  weaknesses  String?
  pricing     String?
  marketShare Float?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  comparisons CompetitorComparison[]
}

model CompetitorComparison {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  competitorId  String
  competitor    Competitor  @relation(fields: [competitorId], references: [id])
  status        CompetitorStatus
  notes         String?
  createdAt     DateTime    @default(now())
}

model Region {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  country     String   @default("Brasil")
  state       String?
  city        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  users       User[]
  companies   Company[]
  priceTables PriceTable[]
  teamBonuses TeamBonus[]
}

model ApprovalWorkflow {
  id          String   @id @default(uuid())
  name        String
  type        WorkflowType
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  approvals   ApprovalRequest[]
}

model ApprovalRequest {
  id          String            @id @default(uuid())
  workflowId  String
  workflow    ApprovalWorkflow  @relation(fields: [workflowId], references: [id])
  entityType  String
  entityId    String
  requesterId String
  requester   User              @relation("ApprovalRequester", fields: [requesterId], references: [id])
  currentStep Int               @default(0)
  status      ApprovalStatus
  data        Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  steps       ApprovalStep[]
}

model ApprovalStep {
  id          String          @id @default(uuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id])
  stepNumber  Int
  approverId  String
  approver    User            @relation("ApprovalApprover", fields: [approverId], references: [id])
  status      StepStatus
  comments    String?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
}

// === CROSS-SELL E UPSELL ===
model CrossSellRule {
  id                String  @id @default(uuid())
  name              String
  mainProductId     String
  mainProduct       Product @relation("MainProduct", fields: [mainProductId], references: [id])
  suggestedProductId String
  suggestedProduct  Product @relation("SuggestedProduct", fields: [suggestedProductId], references: [id])
  probability       Float   @default(0.5)
  discount          Float   @default(0)
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
}

model UpSellRule {
  id              String  @id @default(uuid())
  name            String
  mainProductId   String
  mainProduct     Product @relation("MainProduct", fields: [mainProductId], references: [id])
  targetProductId String
  targetProduct   Product @relation("TargetProduct", fields: [targetProductId], references: [id])
  minQuantity     Int     @default(1)
  discount        Float   @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
}

// === METAS DE VENDAS ===
model SalesTarget {
  id              String   @id @default(uuid())
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])
  targetValue     Float
  targetDeals     Int      @default(0)
  startDate       DateTime
  endDate         DateTime
  description     String?
  bonusPercentage Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// === COMISSÕES POR EQUIPE ===
model TeamBonus {
  id            String   @id @default(uuid())
  regionId      String?
  region        Region?  @relation(fields: [regionId], references: [id])
  totalAmount   Float
  description   String
  period        String
  criteria      Json
  createdAt     DateTime @default(now())
  
  distributions TeamBonusDistribution[]
}

model TeamBonusDistribution {
  id           String    @id @default(uuid())
  teamBonusId  String
  teamBonus    TeamBonus @relation(fields: [teamBonusId], references: [id])
  sellerId     String
  seller       User      @relation(fields: [sellerId], references: [id])
  amount       Float
  percentage   Float
  createdAt    DateTime  @default(now())
}

// === WORKFLOWS AVANÇADOS ===
model AdvancedWorkflow {
  id              String   @id @default(uuid())
  name            String
  description     String?
  type            WorkflowAdvancedType
  category        WorkflowCategory @default(GENERAL)
  trigger         Json
  conditions      Json
  actions         Json
  escalationRules Json?
  priority        Priority @default(MEDIUM)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  executions      WorkflowExecution[]
}

model WorkflowExecution {
  id            String            @id @default(uuid())
  workflowId    String
  workflow      AdvancedWorkflow  @relation(fields: [workflowId], references: [id])
  triggeredById String?
  triggeredBy   User?             @relation(fields: [triggeredById], references: [id])
  triggerData   Json
  status        ExecutionStatus
  results       Json?
  error         String?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?
}

// === NOTIFICAÇÕES AVANÇADAS ===
model Notification {
  id          String             @id @default(uuid())
  type        NotificationType
  title       String
  message     String
  channel     NotificationChannel
  recipientId String
  recipient   User               @relation(fields: [recipientId], references: [id])
  status      NotificationStatus
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())
}

// === PÓS-VENDA ===
model CustomerOnboarding {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  contractId      String?
  contract        Contract? @relation(fields: [contractId], references: [id])
  assignedToId    String
  assignedTo      User     @relation(fields: [assignedToId], references: [id])
  status          OnboardingStatus @default(PENDING)
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  steps           OnboardingStep[]
}

model OnboardingStep {
  id            String            @id @default(uuid())
  onboardingId  String
  onboarding    CustomerOnboarding @relation(fields: [onboardingId], references: [id])
  title         String
  description   String?
  status        StepStatus        @default(PENDING)
  order         Int
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
}

model SupportTicket {
  id           String        @id @default(uuid())
  number       String        @unique
  title        String
  description  String
  priority     Priority      @default(MEDIUM)
  category     String
  status       TicketStatus  @default(OPEN)
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])
  slaDeadline  DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  responses    TicketResponse[]
}

model TicketResponse {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  message    String
  isInternal Boolean       @default(false)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  createdAt  DateTime      @default(now())
}

model NPSSurvey {
  id           String       @id @default(uuid())
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  contractId   String?
  contract     Contract?    @relation(fields: [contractId], references: [id])
  score        Int?
  feedback     String?
  status       SurveyStatus @default(PENDING)
  sentAt       DateTime?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
}

model ChurnAlert {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  riskLevel    ChurnRisk
  score        Float
  reasons      String[]
  assignedToId String?
  assignedTo   User?       @relation(fields: [assignedToId], references: [id])
  status       AlertStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// === CONTRATOS ===
model Contract {
  id              String   @id @default(uuid())
  number          String   @unique
  title           String
  description     String?
  value           Float
  startDate       DateTime
  endDate         DateTime
  status          ContractStatus @default(ACTIVE)
  
  // Campos de SLA
  slaResponseTime    Int?     // Tempo de resposta em horas
  slaResolutionTime  Int?     // Tempo de resolução em horas
  slaAvailability    Float?   // Disponibilidade em % (ex: 99.9)
  slaDescription     String?  // Descrição detalhada do SLA
  
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relacionamentos
  customerOnboardings CustomerOnboarding[]
  npsSurveys         NPSSurvey[]
  attachments        ContractAttachment[]
}

model ContractAttachment {
  id          String   @id @default(uuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyDocument {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String

  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// === CONFIGURAÇÕES DO SISTEMA ===
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === AUTOMAÇÕES ===
model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     WorkflowTrigger
  active      Boolean  @default(true)
  conditions  Json
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        AutomationType
  active      Boolean  @default(true)
  conditions  Json
  actions     Json
  lastRun     DateTime?
}

// === PRÉ-VENDAS ===
model PreSalesRequest {
  id                  String   @id @default(uuid())
  numero              String   @unique
  titulo              String
  descricao           String
  status              PreSalesStatus @default(NOVA)
  prioridade          Priority @default(MEDIUM)
  tiposPrecificacao   String[]
  regimeTributario    String?
  valorSugerido       Float?
  custoTotal          Float?
  margemLucro         Float?
  calculoDetalhes     Json?
  observacoes         String?
  dataAprovacao       DateTime?
  dataRejeicao        DateTime?
  solicitanteId       String
  solicitante         User     @relation("PreSalesRequester", fields: [solicitanteId], references: [id])
  leadId              String?
  lead                Company? @relation("PreSalesLead", fields: [leadId], references: [id])
  opportunityId       String?
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id])
  aprovadoPorId       String?
  aprovadoPor         User?    @relation("PreSalesApprover", fields: [aprovadoPorId], references: [id])
  rejeitadoPorId      String?
  rejeitadoPor        User?    @relation("PreSalesRejecter", fields: [rejeitadoPorId], references: [id])
  items               PreSalesItem[]
  aprovacoes          PreSalesApproval[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PreSalesItem {
  id                  String   @id @default(uuid())
  preSalesRequestId   String
  preSalesRequest     PreSalesRequest @relation(fields: [preSalesRequestId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation("PreSalesProduct", fields: [productId], references: [id])
  descricao           String?
  quantidade          Int      @default(1)
  custoUnitario       Float    @default(0)
  precoSugerido       Float    @default(0)
  margemLucro         Float    @default(0)
  observacoes         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PreSalesApproval {
  id                  String   @id @default(uuid())
  preSalesRequestId   String
  preSalesRequest     PreSalesRequest @relation(fields: [preSalesRequestId], references: [id], onDelete: Cascade)
  aprovadorId         String
  aprovador           User     @relation("PreSalesApprovalApprover", fields: [aprovadorId], references: [id])
  status              ApprovalStatus
  observacoes         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// === B2G: EDITAIS, TR E ATAS ===
model BidNotice {
  id                String          @id @default(uuid())
  type              BidNoticeType   @default(EDITAL)
  title             String
  referenceCode     String?
  organization      String
  stateCode         String?
  modality          String?
  objectDescription String?
  estimatedValue    Float?
  openingDate       DateTime?
  proposalDueDate   DateTime?
  status            BidNoticeStatus @default(MONITORANDO)
  sourceUrl         String?
  documentText      String?
  summary           String?
  aiAnalysis        Json?
  documentation     Json?
  tags              String[]        @default([])
  createdByName     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  history           BidNoticeHistory[]
}

model BidNoticeHistory {
  id            String    @id @default(uuid())
  noticeId      String
  notice        BidNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  eventType     String
  title         String
  details       String?
  payload       Json?
  createdByName String?
  createdAt     DateTime  @default(now())
}

model SavedAnalysis {
  id                  String   @id @default(uuid())
  analysisId          String
  companyId           String
  createdByUserId     String
  fileName            String
  processedAt         String
  extractedData       Json
  originalFileDataUri String?
  summaryPdfDataUri   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([companyId, analysisId])
  @@index([companyId, createdByUserId])
  @@index([createdAt])
}

// === ENUMS ===
enum Role {
  MASTER
  ADMIN
  MANAGER
  DIRECTOR
  SELLER
}

enum Stage {
  LEAD
  QUALIFICATION
  DIAGNOSIS
  PROPOSAL
