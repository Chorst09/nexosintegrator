// === GESTÃO DE KICKOFF ===
model KickoffTemplate {
  id          String       @id @default(uuid())
  name        String
  description String?
  phase       KickoffPhase
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)
  agenda      Json         @default("[]")
  checklist   Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  meetings    KickoffMeeting[]

  @@index([phase])
  @@index([isActive])
}

model KickoffMeeting {
  id            String        @id @default(uuid())
  number        String        @unique
  title         String
  description   String?
  phase         KickoffPhase
  status        KickoffStatus @default(AGENDADA)
  platform      KickoffPlatform @default(MEET)
  meetingLink   String?
  scheduledDate DateTime
  startTime     String?
  endTime       String?
  meetingNotes  String?
  actualStartTime DateTime?
  actualEndTime   DateTime?
  googleCalendarEventId String?
  googleCalendarId      String?

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  ownerId       String
  owner         User        @relation("KickoffOwner", fields: [ownerId], references: [id])
  templateId    String?
  template      KickoffTemplate? @relation(fields: [templateId], references: [id])

  participants  KickoffParticipant[]
  agendaItems   KickoffAgendaItem[]
  checklistItems KickoffChecklistItem[]
  actionItems   KickoffActionItem[]
  history       KickoffHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([companyId])
  @@index([phase, status])
  @@index([scheduledDate])
}

model KickoffParticipant {
  id        String @id @default(uuid())
  meetingId String
  meeting   KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?  @relation("KickoffParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation("KickoffParticipantContact", fields: [contactId], references: [id], onDelete: SetNull)
  role      KickoffParticipantRole @default(INTERNO)
  status    KickoffParticipantStatus @default(CONVIDADO)
  isRequired Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@index([userId])
  @@index([contactId])
}

model KickoffAgendaItem {
  id              String @id @default(uuid())
  meetingId       String
  meeting         KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  tratativa       String?
  durationMinutes Int    @default(15)
  order           Int    @default(0)
  createdAt       DateTime @default(now())

  @@index([meetingId])
}

model KickoffChecklistItem {
  id            String @id @default(uuid())
  meetingId     String
  meeting       KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title         String
  isCompleted   Boolean @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?  @relation("KickoffChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  order         Int    @default(0)
  createdAt     DateTime @default(now())

  @@index([meetingId])
}

model KickoffActionItem {
  id          String @id @default(uuid())
  meetingId   String
  meeting     KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      KickoffActionStatus @default(PENDENTE)
  priority    Priority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?  @relation("KickoffActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  taskId      String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([meetingId])
  @@index([assigneeId])
  @@index([status, dueDate])
}

model KickoffHistory {
  id          String @id @default(uuid())
  meetingId   String
  meeting     KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  data        Json?
  userId      String?
  user        User?  @relation("KickoffHistoryUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([meetingId])
  @@index([meetingId, createdAt])
}

// === GOOGLE CALENDAR INTEGRATION ===
model GoogleToken {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  scope        String
  expiryDate   DateTime
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

