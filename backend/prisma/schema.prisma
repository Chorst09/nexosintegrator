// === MÓDULO DE PROJETOS - Models ===
model Project {
  id              String   @id @default(uuid())
  number          String   @unique
  name            String
  description     String?
  type            ProjectType
  phase           ProjectPhaseType @default(SETUP)
  status          ProjectStatus @default(PLANEJADO)
  budget          Float    @default(0)
  actualCost      Float    @default(0)
  margin          Float    @default(0)
  plannedStartDate DateTime?
  plannedEndDate  DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  healthScore     Int      @default(100)
  progressPercent Int      @default(0)
  metadata        Json     @default("{}")

  opportunityId   String?  @unique
  contractId      String?
  companyId       String
  projectManagerId String
  createdBy       String

  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contract        Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  company         Company      @relation(fields: [companyId], references: [id])
  projectManager  User         @relation("ProjectManager", fields: [projectManagerId], references: [id])
  creator         User         @relation("ProjectCreator", fields: [createdBy], references: [id])

  phases          ProjectPhase[]
  milestones      ProjectMilestone[]
  tasks           ProjectTask[]
  team            ProjectTeam[]
  timelogs        ProjectTimelog[]
  risks           ProjectRisk[]
  issues          ProjectIssue[]
  attachments     ProjectAttachment[]
  changeRequests  ProjectChangeRequest[]
  billings        ProjectBilling[]
  acceptances     ProjectAcceptance[]
  b2gConfig       ProjectB2GConfig?
  b2bConfig       ProjectB2BConfig?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([projectManagerId])
  @@index([status])
  @@index([phase])
  @@index([type])
}

model ProjectPhase {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  order           Int
  status          ProjectPhaseStatus @default(PENDING)
  plannedStartDate DateTime?
  plannedEndDate  DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  progressPercent Int      @default(0)

  milestones      ProjectMilestone[]
  tasks           ProjectTask[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([order])
}

model ProjectMilestone {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId         String?
  phase           ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  status          MilestoneStatus @default(PENDING)
  plannedDate     DateTime?
  actualDate      DateTime?
  billingTrigger  Boolean  @default(false)
  billingValue    Float    @default(0)
  deliverables    Json     @default("[]")

  tasks           ProjectTask[]
  billings        ProjectBilling[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([status])
}

model ProjectTask {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId         String?
  phase           ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id])
  estimatedHours  Float    @default(0)
  actualHours     Float    @default(0)
  dependencyId    String?
  dependency      ProjectTask? @relation("TaskDependency", fields: [dependencyId], references: [id])
  dependents      ProjectTask[] @relation("TaskDependency")

  timelogs        ProjectTimelog[]
  issues          ProjectIssue[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([milestoneId])
  @@index([assignedToId])
  @@index([status])
}

model ProjectTeam {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  role            ProjectRole @default(DEVELOPER)
  allocationPercent Float  @default(100)
  hourlyCost      Float    @default(0)
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean  @default(true)

  timelogs        ProjectTimelog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectTimelog {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String?
  task            ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  teamId          String
  team            ProjectTeam @relation(fields: [teamId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  hours           Float
  date            DateTime @default(now())
  description     String?
  billable        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([teamId])
  @@index([userId])
  @@index([date])
}

model ProjectRisk {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  level           RiskLevel @default(MEDIUM)
  status          RiskStatus @default(IDENTIFIED)
  probability     Int      @default(50)
  impact          Int      @default(50)
  mitigationPlan  String?
  owner           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([level])
  @@index([status])
}

model ProjectIssue {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String?
  task            ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          IssueStatus @default(OPEN)
  priority        Priority @default(MEDIUM)
  assignedTo      String?
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([status])
}

model ProjectAttachment {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename        String
  originalName    String
  mimeType        String
  size            Int
  category        AttachmentCategory @default(OTHER)
  description     String?
  uploadedBy      String
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([category])
}

model ProjectChangeRequest {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          String
  title           String
  description     String?
  type            ChangeRequestType @default(SCOPE)
  status          ChangeRequestStatus @default(SUBMITTED)
  impact          String?
  costImpact      Float    @default(0)
  scheduleImpact  Int      @default(0)
  requestedBy     String
  reviewedBy      String?
  decisionDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([type])
}

model ProjectBilling {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  number          String
  description     String?
  amount          Float
  status          BillingStatus @default(PENDING)
  dueDate         DateTime?
  paidDate        DateTime?
  invoiceRef      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
}

model ProjectAcceptance {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            AcceptanceType @default(PROVISIONAL)
  status          AcceptanceStatus @default(PENDING)
  description     String?
  criteria        Json     @default("[]")
  decisionDate    DateTime?
  decidedBy       String?
  conditions      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([status])
}

model ProjectB2GConfig {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modality        String?
  publicationDate DateTime?
  proposalDeadline DateTime?
  siteVisitDate   DateTime?
  technicalProposal Json   @default("{}")
  economicProposal  Json   @default("{}")
  biddingMinutes  Json     @default("[]")
  status          String   @default("PREPARING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectB2BConfig {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractType    String?
  paymentTerms    String?
  slaTerms        Json     @default("{}")
  deliverables    Json     @default("[]")
  acceptanceCriteria Json  @default("[]")
  status          String   @default("NEGOTIATION")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
