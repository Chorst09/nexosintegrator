{
  "name": "nexoscrm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "npm run build:web",
    "build:web": "cd apps/web && npm run build",
    "install:all": "npm install && cd apps/web && npm install && cd ../api && npm install",
    "prisma:generate": "cd apps/api && npx prisma generate",
    "prisma:migrate": "cd apps/api && npx prisma migrate deploy",
    "prisma:studio": "cd apps/api && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "8.2.2"
  },
  "dependencies": {
    "pdf-parse": "2.4.5",
    "@napi-rs/canvas": "0.1.44",
    "playwright-core": "1.40.0",
    "@sparticuz/chromium": "119.0.2"
  }
}
