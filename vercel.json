{
  "framework": "vite",
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 45
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]?path=$1"
    }
  ]
}
